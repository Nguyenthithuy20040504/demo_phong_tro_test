# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - QUAN TRỌNG: Không commit các file chứa thông tin nhạy cảm
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Chỉ commit file mẫu env.example
!env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gitnexus

# Unused package manager lock files
pnpm-lock.yaml
bun.lock

# Agent / Skill tools (Antigravity & others)
.agent/
.agents/
.claude/

# External projects & old source backups
/demo_phong_tro-main/
/impeccable-main/
/ui-ux-pro-max-skill-main/
/design-system/

# Temp/debug files at root (prevent clutter)
/tmp/
*.log
*.patch
*_old*.tsx
*_old*.ts
*_backup*.ts

# Debug scripts that shouldn't be in source control
/check_*.js
/debug_*.js
/debug-*.js
/fix-*.js
/fix.js
/list-*.js
/list_*.js
/search_*.js
/test-*.js
/test_*.js
/test.js
/trace-*.js
/tmp_*.js
/tmp-*.js
/inspect_*.js
/repro_*.js
/set-*.js
